{
    "name": "to.frames Kino",
    "beschreibung": "Cineastisch und editorial: fast schwarz, ein Korallen-Akzent, Serifen-Überschriften mit kursiver Akzentzeile, nummerierte Listen, Kopfbereich wahlweise mit Paket-Karte.",
    "version": "1.0.0",
    "autor": "to.frames",
    "tokens": {
        "bg": "#0a0a0b",
        "surface": "#131316",
        "surface-2": "#1b1b1f",
        "line": "#26262b",
        "text": "#f4f2ec",
        "text-2": "#b9b5ac",
        "muted": "#86837c",
        "accent": "#f26d6d",
        "accent-ink": "#22100f",
        "ok": "#6fcf97",
        "danger": "#ff8a80",
        "aurora": false,
        "aurora-1": "#506e8c",
        "aurora-2": "#f26d6d",
        "aurora-3": "#506e8c",
        "aurora-staerke": 10,
        "font-body": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
        "font-head": "\"Newsreader\", \"Iowan Old Style\", \"Palatino Linotype\", Palatino, Georgia, serif",
        "head-weight": 500,
        "text-size": 17,
        "radius": "16px",
        "radius-sm": "999px",
        "maxw": "1140px",
        "modus": "dunkel"
    },
    "fonts": [
        { "familie": "Newsreader", "datei": "newsreader-latin-400-normal.woff2", "gewicht": "400", "stil": "normal" },
        { "familie": "Newsreader", "datei": "newsreader-latin-400-italic.woff2", "gewicht": "400", "stil": "italic" },
        { "familie": "Newsreader", "datei": "newsreader-latin-500-normal.woff2", "gewicht": "500", "stil": "normal" },
        { "familie": "Newsreader", "datei": "newsreader-latin-500-italic.woff2", "gewicht": "500", "stil": "italic" }
    ],
    "theme": {
        "version": 1,
        "css": ["theme.css"],
        "basisCss": true,
        "bodyKlasse": "tf",
        "varianten": {
            "hero": { "mit-karte": "Mit Paket-Karte rechts" },
            "karten": { "nummeriert": "Nummerierte Liste (01, 02, 03)" },
            "schritte": { "spalten": "Nebeneinander in Spalten" }
        },
        "zusatzfelder": {
            "hero": {
                "karte": { "typ": "objekt", "label": "Paket-Karte (Variante „Mit Paket-Karte“)", "felder": {
                    "eyebrow": { "typ": "text", "label": "Kleinzeile", "hilfe": "z. B. „Komplettpaket“" },
                    "badge": { "typ": "text", "label": "Plakette", "hilfe": "z. B. „Alles drin“" },
                    "preis": { "typ": "text", "label": "Preis", "hilfe": "z. B. „ab 1.099 €“" },
                    "hinweis": { "typ": "text", "label": "Hinweis unter dem Preis" },
                    "punkte": { "typ": "absaetze", "label": "Punkte mit Häkchen", "einzeilig": true, "knopf": "Punkt hinzufügen" },
                    "knopf": { "typ": "objekt", "label": "Knopf", "felder": {
                        "text": { "typ": "text", "label": "Beschriftung" },
                        "ziel": { "typ": "link", "label": "Ziel" }
                    } }
                } },
                "preisZeile": { "typ": "text", "label": "Preis neben den Knöpfen", "hilfe": "z. B. „ab 1.099 € · Komplettpaket“. Leer = nichts." }
            }
        },
        "sektionen": {
            "leistungen-check": {
                "name": "Leistungen mit Häkchen",
                "beschreibung": "Zweispaltige Liste mit Häkchen, optional ein hervorgehobenes Extra darunter.",
                "zeichen": "✓",
                "menue": "Was ist drin",
                "felder": {
                    "eyebrow": { "typ": "text", "label": "Kleinzeile" },
                    "titel": { "typ": "zeile", "label": "Überschrift", "breit": true },
                    "lead": { "typ": "flaeche", "label": "Einleitung", "breit": true, "zeilen": 2 },
                    "punkte": { "typ": "liste", "label": "Punkte", "knopf": "Punkt hinzufügen", "zeilenTitel": "titel", "kompakt": true, "felder": {
                        "titel": { "typ": "text", "label": "Titel", "pflicht": true },
                        "text": { "typ": "flaeche", "label": "Text", "zeilen": 2, "breit": true }
                    } },
                    "extra": { "typ": "objekt", "label": "Hervorgehobenes Extra (optional)", "felder": {
                        "label": { "typ": "text", "label": "Plakette", "hilfe": "z. B. „Optional“" },
                        "titel": { "typ": "text", "label": "Titel" },
                        "text": { "typ": "text", "label": "Text", "breit": true }
                    } }
                },
                "vorlage": {
                    "farbe": "standard",
                    "eyebrow": "Was ist drin",
                    "titel": "Ein Paket, das alles abdeckt",
                    "lead": "Kein Baukasten, keine versteckten Posten — ein klar geschnürtes Komplettpaket.",
                    "punkte": [
                        { "titel": "Erster Punkt", "text": "Kurz erklärt, was dazugehört." },
                        { "titel": "Zweiter Punkt", "text": "Kurz erklärt, was dazugehört." },
                        { "titel": "Dritter Punkt", "text": "Kurz erklärt, was dazugehört." },
                        { "titel": "Vierter Punkt", "text": "Kurz erklärt, was dazugehört." }
                    ],
                    "extra": { "label": "", "titel": "", "text": "" }
                }
            },
            "preis-band": {
                "name": "Preis-Band",
                "beschreibung": "Zentrierter Block: ein Preis, ein Satz, ein Knopf.",
                "zeichen": "€",
                "menue": "Preis",
                "felder": {
                    "eyebrow": { "typ": "text", "label": "Kleinzeile" },
                    "titel": { "typ": "zeile", "label": "Überschrift", "breit": true },
                    "preis": { "typ": "text", "label": "Preis", "hilfe": "z. B. „ab 1.099 €“" },
                    "text": { "typ": "flaeche", "label": "Text", "breit": true, "zeilen": 3 },
                    "knopf": { "typ": "objekt", "label": "Knopf", "felder": {
                        "text": { "typ": "text", "label": "Beschriftung" },
                        "ziel": { "typ": "link", "label": "Ziel" }
                    } },
                    "fussnote": { "typ": "text", "label": "Kleingedrucktes darunter", "breit": true }
                },
                "vorlage": {
                    "farbe": "standard",
                    "eyebrow": "Das Paket",
                    "titel": "Ein Preis. Alles inklusive.",
                    "preis": "ab 1.099 €",
                    "text": "Der Endpreis hängt von Umfang und Ort ab — festgelegt nach dem kostenlosen Erstgespräch.",
                    "knopf": { "text": "Unverbindlich anfragen", "ziel": "#kontakt" },
                    "fussnote": "Erstgespräch kostenlos & unverbindlich"
                }
            }
        }
    }
}
