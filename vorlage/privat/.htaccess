# Dieser Ordner gehört NICHT in einen Docroot.
#
# Hier liegen die Inhaltsdaten, die Benutzerkonten des Portals, die Designs
# und der Generator. Wenn er versehentlich über eine Domain erreichbar ist,
# verhindern diese Zeilen wenigstens das Herunterladen. Verlass ist darauf
# nicht — der Ordner gehört neben den Docroot, nicht hinein.

<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>

Options -Indexes
